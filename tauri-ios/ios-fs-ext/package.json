{
  "name": "ios-files",
  "displayName": "iOS Files and Linux",
  "description": "Exposes the app's folders and its Ubuntu terminal to the workbench.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "browser": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:ios",
    "onTerminalProfile:ios-linux.ubuntu",
    "onCommand:ios-linux.newTerminal",
    "onCommand:ios-linux.signIn",
    "onCommand:ios-linux.status"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "terminal": {
      "profiles": [
        {
          "id": "ios-linux.ubuntu",
          "title": "Ubuntu"
        }
      ]
    },
    "commands": [
      {
        "command": "ios-linux.newTerminal",
        "title": "VScode: New Ubuntu Terminal"
      },
      {
        "command": "ios-linux.signIn",
        "title": "VScode: Sign in to GitHub"
      },
      {
        "command": "ios-linux.status",
        "title": "VScode: Linux status"
      }
    ]
  }
}
